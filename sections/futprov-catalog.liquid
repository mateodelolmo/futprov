{{ 'futprov.css' | asset_url | stylesheet_tag }}
<script src="{{ 'futprov.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'futprov-catalog.js' | asset_url }}" defer="defer"></script>

{%- assign fp_provider = all_products[settings.fp_provider_product] -%}
<div
  id="fp-catalog"
  class="fp-section color-{{ section.settings.color_scheme }} page-width section-{{ section.id }}-padding"
  data-fp-catalog
  {% if fp_provider != blank %}data-fp-provider-url="{{ fp_provider.url }}"{% endif %}
>
  {%- if section.settings.heading != blank -%}
    <h2 class="title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="fp-catalog__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div class="fp-catalog__toolbar">
    <input
      type="search"
      class="fp-catalog__search"
      data-fp-search
      placeholder="Buscar camiseta por nombre…"
      aria-label="Buscar camiseta por nombre"
    >
    <span class="fp-catalog__count" data-fp-count>Cargando catálogo…</span>
  </div>

  <div class="fp-catalog__chips" data-fp-chips role="group" aria-label="Filtrar por categoría"></div>

  <div class="fp-catalog__grid" data-fp-grid></div>

  <p class="fp-catalog__empty" data-fp-empty>No hay camisetas para ese filtro.</p>

  <div class="fp-catalog__loadmore">
    <button type="button" class="button button--secondary" data-fp-loadmore hidden>Cargar más</button>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
  #shopify-section-{{ section.id }} .fp-catalog__count {
    font-size: 1.3rem;
    opacity: 0.55;
    white-space: nowrap;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Fut Prov · Catálogo",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo el catálogo" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Busca por nombre o filtra por categoría. Consigue el acceso al proveedor para pedir la que quieras." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Fut Prov · Catálogo" }]
}
{% endschema %}
