{{ 'futprov.css' | asset_url | stylesheet_tag }}
<script src="{{ 'futprov.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'futprov-catalog.js' | asset_url }}" defer="defer"></script>

<div
  id="fp-catalog"
  class="fp-section color-{{ section.settings.color_scheme }} page-width section-{{ section.id }}-padding"
  data-fp-catalog
  data-fp-catalog-url="{{ 'catalog.json' | asset_url }}"
  data-fp-product-url="{% if section.settings.product %}{{ section.settings.product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="fp-catalog__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div class="fp-catalog__toolbar">
    <input
      type="search"
      class="fp-catalog__search"
      data-fp-search
      placeholder="Buscar equipo…"
      aria-label="Buscar equipo"
    >
    <div class="fp-catalog__chips" data-fp-chips role="group" aria-label="Filtrar por liga"></div>
  </div>

  <div class="fp-catalog__grid" data-fp-grid></div>

  <p class="fp-catalog__empty" data-fp-empty>No hay camisetas para ese filtro.</p>

  <div class="fp-catalog__loadmore">
    <button type="button" class="button button--secondary" data-fp-loadmore hidden>Cargar más</button>
  </div>
</div>

<div class="fp-lightbox" data-fp-lightbox>
  <button type="button" class="fp-lightbox__close" data-fp-lightbox-close aria-label="Cerrar">&times;</button>
  <img src="" alt="" width="600" height="800">
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Fut Prov · Catálogo",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo lo que puedes conseguir" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Muestra del catálogo disponible a través de nuestro proveedor. Este escaparate no es comprable directamente — consigue el acceso completo con la guía digital." },
    { "type": "product", "id": "product", "label": "Producto al que enlazan las camisetas" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Fut Prov · Catálogo" }]
}
{% endschema %}
