{{ 'futprov.css' | asset_url | stylesheet_tag }}

{%- assign product = section.settings.product -%}

<div class="fp-section color-{{ section.settings.color_scheme }} page-width section-{{ section.id }}-padding">
  <div class="fp-cta{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="fp-cta__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 45vw, 90vw', widths: '450,700,900' }}
      {%- endif -%}
    </div>
    <div class="fp-cta__content">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if product != blank -%}
        <a href="{{ product.url }}" class="button">
          {{ section.settings.button_label }} · {{ product.price | money }}
        </a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 6rem;
    padding-bottom: 6rem;
  }
  #shopify-section-{{ section.id }} .fp-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.2rem;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .fp-cta__media img {
    width: 100%;
    border-radius: 1.2rem;
  }
  #shopify-section-{{ section.id }} .fp-cta__content h2 {
    font-size: clamp(2.8rem, 4vw, 4rem);
    margin-bottom: 1.2rem;
  }
  #shopify-section-{{ section.id }} .fp-cta__content p {
    opacity: 0.75;
    margin-bottom: 2rem;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .fp-cta {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Fut Prov · CTA final",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu nombre, tu dorsal, tu camiseta" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Servicio de personalización sobre camisetas originales. Consigue acceso completo al catálogo del proveedor con la guía digital." },
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Empezar mi pedido" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Fut Prov · CTA final" }]
}
{% endschema %}
