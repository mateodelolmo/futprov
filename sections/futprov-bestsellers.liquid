{{ 'futprov.css' | asset_url | stylesheet_tag }}
<script src="{{ 'futprov.js' | asset_url }}" defer="defer"></script>

<div class="fp-section fp-bestsellers color-{{ section.settings.color_scheme }} page-width section-{{ section.id }}-padding">
  <div class="fp-bestsellers__head" data-fp-inview>
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="fp-bestsellers__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fp-bestsellers__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="fp-bestsellers__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.catalog_label != blank -%}
      <a href="{{ section.settings.catalog_link | default: routes.all_products_collection_url }}" class="button button--secondary">
        {{ section.settings.catalog_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="fp-bestsellers__groups">
    {%- for block in section.blocks -%}
      <div class="fp-bestsellers__group" {{ block.shopify_attributes }}>
        <h3 class="fp-bestsellers__group-title">{{ block.settings.label }}</h3>
        <div class="fp-bestsellers__grid">
          {%- for product in block.settings.products -%}
            <a href="{{ product.url }}" class="fp-bestsellers__card">
              <div class="fp-bestsellers__media">
                {%- if product.featured_image -%}
                  {{
                    product.featured_image
                    | image_url: width: 600
                    | image_tag: loading: 'lazy', widths: '300,450,600', class: 'fp-bestsellers__img'
                  }}
                {%- else -%}
                  <span class="fp-bestsellers__noimg">Sin imagen</span>
                {%- endif -%}
              </div>
              <div class="fp-bestsellers__info">
                <h4>{{ product.title }}</h4>
                <p class="fp-bestsellers__price">{{ product.price | money }}</p>
              </div>
            </a>
          {%- endfor -%}
          {%- if block.settings.products.size == 0 -%}
            <p class="fp-bestsellers__empty">Elige camisetas en el editor de temas.</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.4rem;
    margin-bottom: 2.4rem;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__eyebrow {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fp-accent);
    margin: 0 0 0.4rem;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__heading {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__subheading {
    margin: 0.8rem 0 0;
    font-size: 1.4rem;
    opacity: 0.6;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__group {
    margin-top: 2rem;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__group-title {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.6rem;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__card {
    display: block;
    border-radius: 1.2rem;
    overflow: hidden;
    background: #101212;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__noimg {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    opacity: 0.3;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__info {
    padding: 1rem 1.2rem 1.2rem;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__info h4 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__price {
    margin: 0.4rem 0 0;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--fp-accent);
  }
  #shopify-section-{{ section.id }} .fp-bestsellers__empty {
    opacity: 0.5;
    font-size: 1.3rem;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .fp-bestsellers__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Fut Prov · Más vendidas",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Las más buscadas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Camisetas más vendidas" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "LaLiga, España, Premier League y clásicos Retro." },
    { "type": "text", "id": "catalog_label", "label": "Texto botón catálogo", "default": "Ver todo el catálogo" },
    { "type": "url", "id": "catalog_link", "label": "Enlace botón catálogo", "default": "/collections/all" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Grupo de camisetas",
      "settings": [
        { "type": "text", "id": "label", "label": "Título del grupo", "default": "LaLiga" },
        { "type": "product_list", "id": "products", "label": "Camisetas del grupo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fut Prov · Más vendidas",
      "blocks": [
        { "type": "group", "settings": { "label": "LaLiga", "products": ["25-26-barcelona-primera-equipacion", "84-85-real-madrid-primera-equipacion"] } },
        { "type": "group", "settings": { "label": "España", "products": ["1994-espana-primera-equipacion"] } },
        { "type": "group", "settings": { "label": "Premier League", "products": ["25-26-manchester-city-primera-equipacion-manga-larga", "88-90-arsenal-primera-equipacion"] } },
        { "type": "group", "settings": { "label": "Retro", "products": ["86-87-real-madrid-segunda-equipacion"] } }
      ]
    }
  ]
}
{% endschema %}
